--!strict
-- SPDX-License-Identifier: MIT OR Apache-2.0

--[[
One process of the bench's cold workloads: what a tool that runs once pays for one file from its
first `require` on, each of the package's modules compiling the first time it is needed:

  jess run --capability filesystem.read --package . bench/cold.jsl <workload> <file>

Prints the workload's answer and the seconds it took, tab-separated. `bench.jsl` runs it, seven
processes a workload.
]]

local started = os.clock()
local workload: string, path: string = ...
local bytes = jess.fs.read(path)
local answer = 0

if workload == 'decode' then
  local nif = require '@nif'
  for _, record in nif.open(bytes):records() do
    answer += #(record :: nif.Record).type
  end
elseif workload == 'save' then
  local nif = require '@nif'
  local opened = nif.open(bytes)
  for _ in opened:records() do
  end

  answer = buffer.len(opened:save())
elseif workload == 'read' then
  local nif = require '@nif'
  local opened = nif.open(bytes)
  local scratch: { [string]: { [string]: unknown } } = {}
  for index = 0, opened.count - 1 do
    local name = opened:typeOf(index) :: string
    local into = scratch[name] or {}
    scratch[name] = into
    answer += #(opened:read(index, into) :: nif.Record).type
  end
elseif workload == 'check' then
  local check = require '@nif/check'
  local report = check.check(path, bytes)
  answer = #report.findings + #report.textures
elseif workload == 'scene' then
  local nif = require '@nif'
  local scene = require '@nif/scene'
  local built = scene.build(nif.open(bytes))
  answer = #built.nodes + #built.drawables + #built.issues
elseif workload == 'multi-version' then
  local gamebryo = require '@nif/gamebryo'
  answer = #gamebryo.open(bytes).records
else
  error(`cold.jsl has no workload '{workload}'`, 0)
end

print(`{answer}\t{string.format('%.9f', os.clock() - started)}`)

--!strict
-- SPDX-License-Identifier: MIT OR Apache-2.0

--[[
Reads OpenMW's NIF reader (`components/nif`) for what the multi-version reader needs from it as
data: the record class hierarchy (`struct Name : public Base` in the headers, template
instantiations through `using`), the record types (`RC_*` in `record.hpp`), and the record
factory (`niffile.cpp`). Writes `nif/gamebryo/classes.jsl`:

  jess run --capability filesystem.read --capability filesystem.write \
    generators/openmw.jsl <openmw checkout> src/internal/gamebryo

Run it after updating the OpenMW checkout; the record readers themselves are `gamebryo.jsl`'s
schema, which follows the same headers by hand.
]]

local openmw, outDir = ...
if not openmw or not outDir then
  error('usage: openmw.jsl <openmw checkout> <output folder>', 0)
end

local nifDir = jess.fs.join(openmw, 'components', 'nif')
local headers = [for name in jess.fs.list(nifDir) if string.sub(name, -4) == '.hpp' => name]
table.sort(headers)

local function read(name: string): string
  return jess.fs.read(jess.fs.join(nifDir, name)) or error(`can't read {name}`, 0)
end

local function lines(text: string): { string }
  local out = {}
  for line in string.gmatch(text .. '\n', '([^\n]*)\n') do
    table.insert(out, line)
  end

  return out
end

-- `struct Name : public Base` or `struct Name : Base`; a template's base is its instantiations'.
local parents: { [string]: string } = {}
local templates: { [string]: boolean } = {}
for _, header in headers do
  local list = lines(read(header))
  for number, line in list do
    local name, base = string.match(line, '^%s*struct%s+([%w_]+)%s*:%s*public%s+([%w_:]+)')
    if not name then
      name, base = string.match(line, '^%s*struct%s+([%w_]+)%s*:%s*([%w_:]+)')
    end

    if not name or not base then continue end

    if name == 'Parents' or name == 'Children' then name = 'BSConnectPoint' .. name end

    if number > 1 and string.match(list[number - 1], '^%s*template') then templates[name] = true end

    parents[name] = base
  end
end

-- `using Name = Template<Args>;` instantiates a class under the template's base, and aliases of
-- one instantiation are one class; `using Name = Class;` renames a class.
local aliases: { [string]: string }, instances: { [string]: string } = {}, {}
for _, header in headers do
  for _, line in lines(read(header)) do
    local name, target, args = string.match(line, '^%s*using%s+([%w_]+)%s*=%s*([%w_]+)(%b<>)%s*;')
    if not name then
      name, target = string.match(line, '^%s*using%s+([%w_]+)%s*=%s*([%w_]+)%s*;')
    end

    if not name or not target then continue end

    if templates[target] then
      local key = `{target}{args or ''}`
      if instances[key] then
        aliases[name] = instances[key]
      else
        instances[key] = name
        parents[name] = parents[target]
      end
    elseif parents[target] then
      aliases[name] = target
    end
  end
end

for template in templates do
  parents[template] = nil
end

local function resolve(name: string): string return aliases[name] or name end

local function chain(name: string): { string }
  local out = { name }
  while parents[out[#out]] and parents[out[#out]] ~= 'Record' do
    table.insert(out, parents[out[#out]])
  end

  return out
end

local classes = {}
for name in parents do
  local list = chain(name)
  if parents[list[#list]] == 'Record' then table.insert(classes, name) end
end

table.sort(classes)

local recordTypes = {}
for _, line in lines(read 'record.hpp') do
  local name = string.match(line, '^%s*RC_([%w_]+),?')
  if name then table.insert(recordTypes, name) end
end

local factory = {}
local source = read '../nif/niffile.cpp'
for recordName, class, recordType in
  string.gmatch(source, '{%s*"([^"]+)",%s*&construct<([%w_:]+),%s*RC_([%w_]+)>%s*}')

do
  table.insert(factory, { recordName, resolve((string.gsub(class, '::', ''))), recordType })
end

local isClass = {}
for _, class in classes do
  isClass[class] = true
end

for _, entry in factory do
  if not isClass[entry[2]] then error(`factory class {entry[2]} is outside the hierarchy`, 0) end
end

-- The tables are written as text the module reads when it loads. As constructors their thousand
-- entries are a thousand stores to compile, which took ten times as long as reading these does.
local out = {
  '--!strict',
  '--!native',
  '-- SPDX-License-Identifier: MIT OR Apache-2.0',
  '-- @generated by generator/openmw.jsl from OpenMW\'s components/nif. Do not edit.',
  '',
  '--- Each record class and the class it derives from, up to `Record`, a line each.',
  'local ParentLines = [[',
}

for _, class in classes do
  table.insert(out, `{class} {parents[class]}`)
end

table.insert(out, ']]')
table.insert(out, '')
table.insert(out, '--- Each `RecordType`, what a record is, which several record names can share.')
table.insert(out, 'local RecordTypeLines = [[')
for _, name in recordTypes do
  table.insert(out, name)
end

table.insert(out, ']]')
table.insert(out, '')
table.insert(out, '--- The record factory: each record name, its class, and its record type.')
table.insert(out, 'local FactoryLines = [[')
for _, entry in factory do
  for _, word in entry do
    if string.find(word, '%s') then error(`'{word}' can't be a word of a line`, 0) end
  end

  table.insert(out, table.concat(entry, ' '))
end

for _, line in
  {
    ']]',
    '',
    '-- Read here rather than written as tables: a constructor of a thousand entries is a thousand',
    '-- stores to compile, ten times the work of reading the lines.',
    'local Parents: { [string]: string } = {}',
    'for class, parent in string.gmatch(ParentLines, \'(%S+) (%S+)\') do',
    '  Parents[class] = parent',
    'end',
    '',
    'local RecordTypes: { string } = {}',
    'for name in string.gmatch(RecordTypeLines, \'%S+\') do',
    '  table.insert(RecordTypes, name)',
    'end',
    '',
    'local Factory: { [string]: { string } } = {}',
    'for name, class, recordType in string.gmatch(FactoryLines, \'(%S+) (%S+) (%S+)\') do',
    '  Factory[name] = { class, recordType }',
    'end',
    '',
    'return table.freeze { parents = Parents, recordTypes = RecordTypes, factory = Factory }',
  }

do
  table.insert(out, line)
end

jess.fs.write(jess.fs.join(outDir, 'classes.jsl'), table.concat(out, '\n') .. '\n')
print(`{#classes} classes, {#factory} factory entries, {#recordTypes} record types`)

        buffer.readf32(bytes, cursor + 4),
        buffer.readf32(bytes, cursor + 8),
        buffer.readf32(bytes, cursor + 12)
      ),
      tension = buffer.readf32(bytes, cursor + 16),
      continuity = buffer.readf32(bytes, cursor + 20),
      bias = buffer.readf32(bytes, cursor + 24),
    }
  end

  return list
end


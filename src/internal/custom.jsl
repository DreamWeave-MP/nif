--!strict
--!native
-- SPDX-License-Identifier: MIT OR Apache-2.0

--[[
The fields whose layout the schema can't say: keyframe unions, bounding volumes, texture maps
and sources, sequence targets, shared normals, and UV sets. Each codec comes as `read`
(`(bytes, cursor, ...) -> (value, cursor)`), `write` (`(writer, value, map, ...)`), and, when it
holds links, `links` (`(value, links, linkCount) -> linkCount`), the shapes the record modules
have for the rest; their scanners are `custom_scan.jsl`.

The codecs are in `custom/`, by what they are for, and each of those modules is required the
first time a record asks for one of its codecs: a module's functions are all compiled when it
loads, and a mesh with no keys or textures never asks for theirs. Each has its own copy of the
few small reads and writes it calls, where the compiler can put them in line.
]]

--- An enum's number: the value itself, or the number its name stands for.
local function enumValue(values: { [string]: number }, value: string | number): number
  if type(value) == 'number' then return value end

  local number = values[value]
  if not number then error(`unknown enum value '{value}'`, 0) end

  return number
end

--- The identity rotation, shared by every record that stores exactly it (the record modules test
--- the bits): most do. Frozen, so edit a record's rotation by giving it a new table.
local Identity =
  table.freeze { vector.create(1, 0, 0), vector.create(0, 1, 0), vector.create(0, 0, 1) }

--- The codecs one module of `custom/` holds, by name.
type Part = { [string]: unknown }

local function keys(): Part return require './custom/keys' end

local function bounds(): Part return require './custom/bounds' end

local function textures(): Part return require './custom/textures' end

local function sequences(): Part return require './custom/sequences' end

local function geometry(): Part return require './custom/geometry' end

--- What requires each codec's module, by the codec's name.
local Parts: { [string]: () -> Part } = table.freeze {
  floatKeys = keys,
  morphKeys = keys,
  posKeys = keys,
  rotKeys = keys,
  colorKeys = keys,
  boundingVolume = bounds,
  textureMaps = textures,
  textureSource = textures,
  sequenceTarget = sequences,
  nameControllerPairs = sequences,
  sharedNormals = geometry,
  uvSets = geometry,
  uvSetTotal = geometry,
  uvSetCount = geometry,
}

--- What the record modules see: every codec by name, as though all were here.
type Custom = typeof(require './custom/keys')
  & typeof(require './custom/bounds')
  & typeof(require './custom/textures')
  & typeof(require './custom/sequences')
  & typeof(require './custom/geometry')
  & { identity: typeof(Identity), enumValue: typeof(enumValue) }

local Loaded: Part = { identity = Identity, enumValue = enumValue }
local Meta = {}

--- A codec not asked for before: its module's codecs all go in `Loaded`, where the next read of
--- any of them finds it. The export is frozen, so `Loaded` is a table of its own behind it.
function Meta.__index(_: Part, name: string): unknown
  local found = Loaded[name]
  if found ~= nil then return found end

  local part = Parts[name]
  if not part then return nil end

  for key, codec in part() do
    Loaded[key] = codec
  end

  return Loaded[name]
end

return (setmetatable({}, Meta) :: unknown) :: Custom

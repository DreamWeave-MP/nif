function read.bhkMalleableConstraintCInfo(stream: Stream.Stream, cursor: number): (any, number)
  local bytes, version, userVersion, bethVersion =
    stream.bytes, stream.version, stream.userVersion, stream.bethVersion

  local type
  local info
  local ballAndSocketInfo
  local hingeInfo
  local limitedHingeInfo
  local prismaticInfo
  local ragdollInfo
  local stiffSpringInfo
  local _plain
  local tau
  local damping
  local strength
  type = buffer.readu32(bytes, cursor)
  cursor += 4
  info, cursor = ReadStruct.bhkConstraintCInfo(stream, cursor)

  if type == 0 then
    ballAndSocketInfo = {
      pivotA = Stream.vec4(bytes, cursor),
      pivotB = Stream.vec4(bytes, cursor + 16),
    }

    cursor += 32
  else
    ballAndSocketInfo = DefaultStruct.bhkBallAndSocketConstraintCInfo()
  end

  if type == 1 then
    hingeInfo, cursor = ReadStruct.bhkHingeConstraintCInfo(stream, cursor)
  else
    hingeInfo = DefaultStruct.bhkHingeConstraintCInfo()
  end

  if type == 2 then
    limitedHingeInfo, cursor = ReadStruct.bhkLimitedHingeConstraintCInfo(stream, cursor)
  else
    limitedHingeInfo = DefaultStruct.bhkLimitedHingeConstraintCInfo()
  end

  if type == 6 then
    prismaticInfo, cursor = ReadStruct.bhkPrismaticConstraintCInfo(stream, cursor)
  else
    prismaticInfo = DefaultStruct.bhkPrismaticConstraintCInfo()
  end

  if type == 7 then
    ragdollInfo, cursor = ReadStruct.bhkRagdollConstraintCInfo(stream, cursor)
  else
    ragdollInfo = DefaultStruct.bhkRagdollConstraintCInfo()
  end

  if type == 8 then
    stiffSpringInfo = {
      pivotA = Stream.vec4(bytes, cursor),
      pivotB = Stream.vec4(bytes, cursor + 16),
      length = buffer.readf32(bytes, cursor + 32),
    }

    cursor += 36
  else
    stiffSpringInfo = DefaultStruct.bhkStiffSpringConstraintCInfo()
  end

  _plain = type == 0 or type == 1 or type == 2 or type == 6 or type == 7 or type == 8
  if not (_plain) then Stream.fail('Unrecognized constraint type in bhkMalleableConstraint') end

  if version <= 0x14000005 then
    tau = buffer.readf32(bytes, cursor)
    cursor += 4
  else
    tau = 0
  end

  if version <= 0x14000005 then
    damping = buffer.readf32(bytes, cursor)
    cursor += 4
  else
    damping = 0
  end

  if version > 0x14000005 then
    strength = buffer.readf32(bytes, cursor)
    cursor += 4
  else
    strength = 0
  end

  return {
    type = type,
    info = info,
    ballAndSocketInfo = ballAndSocketInfo,
    hingeInfo = hingeInfo,
    limitedHingeInfo = limitedHingeInfo,
    prismaticInfo = prismaticInfo,
    ragdollInfo = ragdollInfo,
    stiffSpringInfo = stiffSpringInfo,
    tau = tau,
    damping = damping,
    strength = strength,
  }, cursor
end


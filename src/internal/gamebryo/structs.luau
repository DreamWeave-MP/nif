function read.bhkSpringDamperConstraintMotor(stream: Stream.Stream, cursor: number): (any, number)
  local bytes, version, userVersion, bethVersion =
    stream.bytes, stream.version, stream.userVersion, stream.bethVersion

  local minForce
  local maxForce
  local springConstant
  local springDamping
  local enabled
  minForce = buffer.readf32(bytes, cursor)
  cursor += 4
  maxForce = buffer.readf32(bytes, cursor)
  cursor += 4
  springConstant = buffer.readf32(bytes, cursor)
  cursor += 4
  springDamping = buffer.readf32(bytes, cursor)
  cursor += 4

  if version < 0x04010000 then
    enabled = buffer.readi32(bytes, cursor) ~= 0
    cursor += 4
  else
    enabled = buffer.readi8(bytes, cursor) ~= 0
    cursor += 1
  end

  return {
    minForce = minForce,
    maxForce = maxForce,
    springConstant = springConstant,
    springDamping = springDamping,
    enabled = enabled,
  }, cursor
end


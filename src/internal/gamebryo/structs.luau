function read.bhkCMSChunk(stream: Stream.Stream, cursor: number): (any, number)
  local bytes, version, userVersion, bethVersion =
    stream.bytes, stream.version, stream.userVersion, stream.bethVersion

  local translation
  local materialIndex
  local reference
  local transformIndex
  local vertices
  local indices
  local strips
  local weldingInfos

  translation = {
    buffer.readf32(bytes, cursor),
    buffer.readf32(bytes, cursor + 4),
    buffer.readf32(bytes, cursor + 8),
    buffer.readf32(bytes, cursor + 12),
  }

  cursor += 16
  materialIndex = buffer.readu32(bytes, cursor)
  cursor += 4
  reference = buffer.readu16(bytes, cursor)
  cursor += 2
  transformIndex = buffer.readu16(bytes, cursor)
  cursor += 2

  do
    local count = buffer.readu32(bytes, cursor)
    cursor += 4

    if cursor + count * 2 > stream.length then
      Stream.viewFail(stream, cursor, count, 'u16', 2, true)
    end

    vertices = if count == 0
      then Empties.u16
      else setmetatable({ buffer = bytes, offset = cursor, count = count, stride = 2 }, Metas.u16)

    cursor += count * 2
  end

  do
    local count = buffer.readu32(bytes, cursor)
    cursor += 4

    if cursor + count * 2 > stream.length then
      Stream.viewFail(stream, cursor, count, 'u16', 2, true)
    end

    indices = if count == 0
      then Empties.u16
      else setmetatable({ buffer = bytes, offset = cursor, count = count, stride = 2 }, Metas.u16)

    cursor += count * 2
  end

  do
    local count = buffer.readu32(bytes, cursor)
    cursor += 4

    if cursor + count * 2 > stream.length then
      Stream.viewFail(stream, cursor, count, 'u16', 2, true)
    end

    strips = if count == 0
      then Empties.u16
      else setmetatable({ buffer = bytes, offset = cursor, count = count, stride = 2 }, Metas.u16)

    cursor += count * 2
  end

  do
    local count = buffer.readu32(bytes, cursor)
    cursor += 4

    if cursor + count * 2 > stream.length then
      Stream.viewFail(stream, cursor, count, 'u16', 2, true)
    end

    weldingInfos = if count == 0
      then Empties.u16
      else setmetatable({ buffer = bytes, offset = cursor, count = count, stride = 2 }, Metas.u16)

    cursor += count * 2
  end

  return {
    translation = translation,
    materialIndex = materialIndex,
    reference = reference,
    transformIndex = transformIndex,
    vertices = vertices,
    indices = indices,
    strips = strips,
    weldingInfos = weldingInfos,
  }, cursor
end


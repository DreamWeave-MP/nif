  if _segments < numTotalSegments then
    subSegmentData, cursor = ReadStruct.BSSubIndexTriShapeSubSegmentData(stream, cursor)
  else
    subSegmentData = DefaultStruct.BSSubIndexTriShapeSubSegmentData()
  end

  return {
    numPrimitives = numPrimitives,

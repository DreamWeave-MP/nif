function read.hkpMoppCode(stream: Stream.Stream, cursor: number): (any, number)
  local bytes, version, userVersion, bethVersion =
    stream.bytes, stream.version, stream.userVersion, stream.bethVersion

  local _dataSize
  local offset
  local buildType
  local data
  _dataSize = buffer.readu32(bytes, cursor)
  cursor += 4

  if version >= 0x0A010000 then
    offset = {
      buffer.readf32(bytes, cursor),
      buffer.readf32(bytes, cursor + 4),
      buffer.readf32(bytes, cursor + 8),
      buffer.readf32(bytes, cursor + 12),
    }

    cursor += 16
  else
    offset = Stream.zero4
  end

  if bethVersion > 34 then
    buildType = buffer.readu8(bytes, cursor)
    cursor += 1
  else
    buildType = 0
  end

  do
    local count = _dataSize

    if cursor + count * 1 > stream.length then
      Stream.viewFail(stream, cursor, count, 'u8', 1, true)
    end

    data = if count == 0
      then Empties.u8
      else setmetatable({ buffer = bytes, offset = cursor, count = count, stride = 1 }, Metas.u8)

    cursor += count * 1
  end

  return { offset = offset, buildType = buildType, data = data }, cursor
end

function default.hkpMoppCode(): any
  local made = shared.hkpMoppCode
  if made then return made end

  made = table.freeze({ offset = Stream.zero4, buildType = 0, data = Empties.u8 })
  shared.hkpMoppCode = made
  return made
end

return { read = read, default = default, rows = rows }

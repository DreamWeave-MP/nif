function read.NiTexturingPropertyTexture(stream: Stream.Stream, cursor: number): (any, number)
  local bytes, version, userVersion, bethVersion =
    stream.bytes, stream.version, stream.userVersion, stream.bethVersion

  local enabled
  local sourceTexture = -1
  local clamp = 0
  local filter = 0
  local _flags = 0
  local maxAnisotropy = 0
  local uvSet = 0
  local hasTransform = false
  local transform = DefaultStruct.NiTextureTransform()

  if version < 0x04010000 then
    enabled = buffer.readi32(bytes, cursor) ~= 0
    cursor += 4
  else
    enabled = buffer.readi8(bytes, cursor) ~= 0
    cursor += 1
  end

  if not (not enabled) then
    if version >= 0x0303000D then
      sourceTexture = buffer.readi32(bytes, cursor)
      cursor += 4
      if sourceTexture < -1 then Stream.invalidLink(sourceTexture) end
    end

    if version <= 0x14000005 then
      clamp = buffer.readu32(bytes, cursor)
      cursor += 4
    end

    if version <= 0x14000005 then
      filter = buffer.readu32(bytes, cursor)
      cursor += 4
    end

    if version > 0x14000005 then
      _flags = buffer.readu16(bytes, cursor)
      cursor += 2
    end

    if version > 0x14000005 then
      clamp = bit32.band(_flags, 15)
    end

    if version > 0x14000005 then
      filter = bit32.extract(_flags, 4, 4)
    end

    if version >= 0x14050004 then
      maxAnisotropy = buffer.readu16(bytes, cursor)
      cursor += 2
    end

    if version <= 0x14000005 then
      uvSet = buffer.readu32(bytes, cursor)
      cursor += 4
    end

    if version <= 0x0A040001 then
      cursor = Stream.skip(stream, cursor, 4)
    end

    if version <= 0x0401000C then
      cursor = Stream.skip(stream, cursor, 2)
    end

    if version >= 0x0A010000 then
      if version < 0x04010000 then
        hasTransform = buffer.readi32(bytes, cursor) ~= 0
        cursor += 4
      else
        hasTransform = buffer.readi8(bytes, cursor) ~= 0
        cursor += 1
      end
    end

    if hasTransform then
      transform = {
        offset = vector.create(buffer.readf32(bytes, cursor), buffer.readf32(bytes, cursor + 4), 0),
        scale = vector.create(
          buffer.readf32(bytes, cursor + 8),
          buffer.readf32(bytes, cursor + 12),
          0
        ),
        rotation = buffer.readf32(bytes, cursor + 16),
        transformMethod = buffer.readu32(bytes, cursor + 20),
        origin = vector.create(
          buffer.readf32(bytes, cursor + 24),
          buffer.readf32(bytes, cursor + 28),
          0
        ),
      }

      cursor += 32
    end
  end

  return {
    enabled = enabled,
    sourceTexture = sourceTexture,
    clamp = clamp,
    filter = filter,
    maxAnisotropy = maxAnisotropy,
    uvSet = uvSet,
    hasTransform = hasTransform,
    transform = transform,
  }, cursor
end


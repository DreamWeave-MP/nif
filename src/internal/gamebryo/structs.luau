function read.BSSubIndexTriShapeSubSegmentData(stream: Stream.Stream, cursor: number): (any, number)
  local bytes, version, userVersion, bethVersion =
    stream.bytes, stream.version, stream.userVersion, stream.bethVersion

  local _arrayIndices
  local _records
  local arrayIndices
  local dataRecords
  local ssfFile
  _arrayIndices = buffer.readu32(bytes, cursor)
  cursor += 4
  _records = buffer.readu32(bytes, cursor)
  cursor += 4

  do
    local count = _arrayIndices
    Stream.checkSize(stream, count * 4)

    do
      local elements = table.create(count)

      for index = 1, count do
        elements[index] = buffer.readu32(bytes, cursor)
        cursor += 4
      end

      arrayIndices = elements
    end
  end

  do
    local count = _records

    do
      local elements = table.create(count)

      for index = 1, count do
        elements[index], cursor = ReadStruct.BSSubIndexTriShapeSubSegmentDataRecord(stream, cursor)
      end

      dataRecords = elements
    end
  end

  ssfFile, cursor = Custom.sizedU16(stream, cursor)

  return { arrayIndices = arrayIndices, dataRecords = dataRecords, ssfFile = ssfFile }, cursor
end


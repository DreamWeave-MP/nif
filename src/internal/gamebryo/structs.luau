    buffer.readf32(bytes, cursor + 8),
    buffer.readf32(bytes, cursor + 12),
  }

  cursor += 16
  length = buffer.readf32(bytes, cursor)
  cursor += 4

  return { pivotA = pivotA, pivotB = pivotB, length = length }, cursor
end


function read.NiGeometryMaterialData(stream: Stream.Stream, cursor: number): (any, number)
  local bytes, version, userVersion, bethVersion =
    stream.bytes, stream.version, stream.userVersion, stream.bethVersion

  local _count = 0
  local _flag = false
  local names = Stream.empty
  local extra = Empties.i32
  local active = -1
  local needsUpdate = false

  if not (version < 0x0A000100) then
    if version >= 0x14020005 then
      _count = buffer.readu32(bytes, cursor)
      cursor += 4
    end

    if version < 0x14020005 and version <= 0x14010003 then
      if version < 0x04010000 then
        _flag = buffer.readi32(bytes, cursor) ~= 0
        cursor += 4
      else
        _flag = buffer.readi8(bytes, cursor) ~= 0
        cursor += 1
      end
    end

    _count = if _flag then 1 else _count

    do
      local count = _count
      Stream.checkSize(stream, count * 4)

      do
        local elements = table.create(count)

        for index = 1, count do
          if version >= 0x14010001 then
            elements[index] = stream.strings[buffer.readu32(bytes, cursor) + 1]
              or Stream.stringIndex(stream, buffer.readu32(bytes, cursor))

            cursor += 4
          else
            elements[index], cursor = Stream.sizedU32(stream, cursor)
          end
        end

        names = elements
      end
    end

    do
      local count = _count

      if cursor + count * 4 > stream.length then
        Stream.viewFail(stream, cursor, count, 'i32', 4, true)
      end

      extra = if count == 0
        then Empties.i32
        else setmetatable({ buffer = bytes, offset = cursor, count = count, stride = 4 }, Metas.i32)

      cursor += count * 4
    end

    if version >= 0x14020005 then
      active = buffer.readi32(bytes, cursor)
      cursor += 4
    end

    if version >= 0x14020007 then
      if version < 0x04010000 then
        needsUpdate = buffer.readi32(bytes, cursor) ~= 0
        cursor += 4
      else
        needsUpdate = buffer.readi8(bytes, cursor) ~= 0
        cursor += 1
      end
    end
  end

  return { names = names, extra = extra, active = active, needsUpdate = needsUpdate }, cursor
end


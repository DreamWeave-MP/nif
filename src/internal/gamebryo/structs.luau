function read.BSSubIndexTriShapeSubSegmentDataRecord(
  stream: Stream.Stream,
  cursor: number
): (any, number)
  local bytes, version, userVersion, bethVersion =
    stream.bytes, stream.version, stream.userVersion, stream.bethVersion

  local userSlotId
  local material
  local extraData
  userSlotId = buffer.readu32(bytes, cursor)
  cursor += 4
  material = buffer.readu32(bytes, cursor)
  cursor += 4

  do
    local count = buffer.readu32(bytes, cursor)
    cursor += 4

    if cursor + count * 4 > stream.length then
      Stream.viewFail(stream, cursor, count, 'f32', 4, true)
    end

    extraData = if count == 0

    stream.bytes, stream.version, stream.userVersion, stream.bethVersion

  local format
  local colorMasks
  local bitsPerPixel = 0
  local compareBits
  local pixelTiling = 0
  local rendererHint
  local extraData
  local flags
  local useSrgb
  local channels
  format = buffer.readu32(bytes, cursor)
  cursor += 4

  if version <= 0x0A040001 then
    do
      local elements = table.create(4)

      for index = 1, 4 do
        elements[index] = buffer.readu32(bytes, cursor)
        cursor += 4
      end

      colorMasks = elements
    end
  else
    colorMasks = table.create(4, 0)
  end

  if version <= 0x0A040001 then
    bitsPerPixel = buffer.readu32(bytes, cursor)
    cursor += 4
  end

  if version <= 0x0A040001 then
    do
      local elements = table.create(2)

      for index = 1, 2 do
        elements[index] = buffer.readu32(bytes, cursor)
        cursor += 4
      end

      compareBits = elements
    end
  else
    compareBits = table.create(2, 0)
  end

  if version <= 0x0A040001 and version >= 0x0A010000 then
    pixelTiling = buffer.readu32(bytes, cursor)
    cursor += 4
  end

  if version > 0x0A040001 then
    bitsPerPixel = buffer.readu8(bytes, cursor)
    cursor += 1
  end

  if version > 0x0A040001 then
    rendererHint = buffer.readu32(bytes, cursor)
    cursor += 4
  else
    rendererHint = 0
  end

  if version > 0x0A040001 then
    extraData = buffer.readu32(bytes, cursor)
    cursor += 4
  else
    extraData = 0
  end

  if version > 0x0A040001 then
    flags = buffer.readu8(bytes, cursor)
    cursor += 1
  else
    flags = 0
  end

  if version > 0x0A040001 then
    pixelTiling = buffer.readu32(bytes, cursor)
    cursor += 4
  end

  if version > 0x0A040001 and version >= 0x14030004 then
    if version < 0x04010000 then
      useSrgb = buffer.readi32(bytes, cursor) ~= 0
      cursor += 4
    else
      useSrgb = buffer.readi8(bytes, cursor) ~= 0
      cursor += 1
    end
  else
    useSrgb = false
  end

  if version > 0x0A040001 then
    channels, cursor = Stream.structRows(stream, cursor, 4, ReadStruct.NiPixelFormatChannelData)
  else
    channels = {
      DefaultStruct.NiPixelFormatChannelData(),
      DefaultStruct.NiPixelFormatChannelData(),
      DefaultStruct.NiPixelFormatChannelData(),
      DefaultStruct.NiPixelFormatChannelData(),
    }
  end

  return {
    format = format,
    colorMasks = colorMasks,
    bitsPerPixel = bitsPerPixel,
    compareBits = compareBits,
    pixelTiling = pixelTiling,
    rendererHint = rendererHint,
    extraData = extraData,
    flags = flags,
    useSrgb = useSrgb,
    channels = channels,
  }, cursor
end

function default.NiPixelFormat(): any
  local made = shared.NiPixelFormat
  if made then return made end

  made = table.freeze({
    format = 0,
    colorMasks = table.create(4, 0),
    bitsPerPixel = 0,
    compareBits = table.create(2, 0),
    pixelTiling = 0,
    rendererHint = 0,
    extraData = 0,
    flags = 0,
    useSrgb = false,
    channels = {
      DefaultStruct.NiPixelFormatChannelData(),
      DefaultStruct.NiPixelFormatChannelData(),
      DefaultStruct.NiPixelFormatChannelData(),
      DefaultStruct.NiPixelFormatChannelData(),
    },
  })

  shared.NiPixelFormat = made
  return made
end

function read.NiPixelFormatChannelData(stream: Stream.Stream, cursor: number): (any, number)
  local bytes, version, userVersion, bethVersion =
    stream.bytes, stream.version, stream.userVersion, stream.bethVersion

  local type
  local convention
  local bitsPerChannel
  local signed
  type = buffer.readu32(bytes, cursor)
  cursor += 4
  convention = buffer.readu32(bytes, cursor)
  cursor += 4
  bitsPerChannel = buffer.readu8(bytes, cursor)
  cursor += 1

  if version < 0x04010000 then
    signed = buffer.readi32(bytes, cursor) ~= 0

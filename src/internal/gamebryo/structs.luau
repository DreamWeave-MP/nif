function read.ControlledBlock(stream: Stream.Stream, cursor: number): (any, number)
  local bytes, version, userVersion, bethVersion =
    stream.bytes, stream.version, stream.userVersion, stream.bethVersion

  local targetName
  local interpolator
  local controller
  local blendInterpolator = -1
  local blendIndex = 0
  local priority = 0
  local _offsets = false
  local stringPalette = -1
  local nodeNameOffset = 0
  local propertyTypeOffset = 0
  local controllerTypeOffset = 0
  local controllerIdOffset = 0
  local interpolatorIdOffset = 0
  local nodeName = ''
  local propertyType = ''
  local controllerType = ''
  local controllerId = ''
  local interpolatorId = ''

  if version <= 0x0A010067 then
    targetName, cursor = Stream.sizedU32(stream, cursor)
  else
    targetName = ''
  end

  if version >= 0x0A01006A then
    interpolator = buffer.readi32(bytes, cursor)
    cursor += 4
    if interpolator < -1 then Stream.invalidLink(interpolator) end
  else
    interpolator = -1
  end

  if version <= 0x14050000 then
    controller = buffer.readi32(bytes, cursor)
    cursor += 4
    if controller < -1 then Stream.invalidLink(controller) end
  else
    controller = -1
  end

  if not (version <= 0x0A010067) then
    if version <= 0x0A01006E then
      blendInterpolator = buffer.readi32(bytes, cursor)
      cursor += 4
      if blendInterpolator < -1 then Stream.invalidLink(blendInterpolator) end
    end

    if version <= 0x0A01006E then
      blendIndex = buffer.readu16(bytes, cursor)
      cursor += 2
    end

    if version >= 0x0A01006A and bethVersion > 0 then
      priority = buffer.readu8(bytes, cursor)
      cursor += 1
    end

    _offsets = version >= 0x0A020000 and version <= 0x14010000

    if _offsets then
      stringPalette = buffer.readi32(bytes, cursor)
      cursor += 4
      if stringPalette < -1 then Stream.invalidLink(stringPalette) end
    end

    if _offsets then
      nodeNameOffset = buffer.readu32(bytes, cursor)
      cursor += 4
    end

    if _offsets then
      propertyTypeOffset = buffer.readu32(bytes, cursor)
      cursor += 4
    end

    if _offsets then
      controllerTypeOffset = buffer.readu32(bytes, cursor)
      cursor += 4
    end

    if _offsets then
      controllerIdOffset = buffer.readu32(bytes, cursor)
      cursor += 4
    end

    if _offsets then
      interpolatorIdOffset = buffer.readu32(bytes, cursor)
      cursor += 4
    end

    if not _offsets then
      if version >= 0x14010001 then
        nodeName = stream.strings[buffer.readu32(bytes, cursor) + 1]
          or Stream.stringIndex(stream, buffer.readu32(bytes, cursor))

        cursor += 4
      else
        nodeName, cursor = Stream.sizedU32(stream, cursor)
      end
    end

    if not _offsets then
      if version >= 0x14010001 then
        propertyType = stream.strings[buffer.readu32(bytes, cursor) + 1]
          or Stream.stringIndex(stream, buffer.readu32(bytes, cursor))

        cursor += 4
      else
        propertyType, cursor = Stream.sizedU32(stream, cursor)
      end
    end

    if not _offsets then
      if version >= 0x14010001 then
        controllerType = stream.strings[buffer.readu32(bytes, cursor) + 1]
          or Stream.stringIndex(stream, buffer.readu32(bytes, cursor))

        cursor += 4
      else
        controllerType, cursor = Stream.sizedU32(stream, cursor)
      end
    end

    if not _offsets then
      if version >= 0x14010001 then
        controllerId = stream.strings[buffer.readu32(bytes, cursor) + 1]
          or Stream.stringIndex(stream, buffer.readu32(bytes, cursor))

        cursor += 4
      else
        controllerId, cursor = Stream.sizedU32(stream, cursor)
      end
    end

    if not _offsets then
      if version >= 0x14010001 then
        interpolatorId = stream.strings[buffer.readu32(bytes, cursor) + 1]
          or Stream.stringIndex(stream, buffer.readu32(bytes, cursor))

        cursor += 4
      else
        interpolatorId, cursor = Stream.sizedU32(stream, cursor)
      end
    end
  end

  return {
    targetName = targetName,
    interpolator = interpolator,
    controller = controller,
    blendInterpolator = blendInterpolator,
    blendIndex = blendIndex,
    priority = priority,
    stringPalette = stringPalette,
    nodeNameOffset = nodeNameOffset,
    propertyTypeOffset = propertyTypeOffset,
    controllerTypeOffset = controllerTypeOffset,
    controllerIdOffset = controllerIdOffset,
    interpolatorIdOffset = interpolatorIdOffset,
    nodeName = nodeName,
    propertyType = propertyType,
    controllerType = controllerType,
    controllerId = controllerId,
    interpolatorId = interpolatorId,
  }, cursor
end


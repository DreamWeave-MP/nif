  local bytes, version, userVersion, bethVersion =
    stream.bytes, stream.version, stream.userVersion, stream.bethVersion

  local numPrimitives
  local _segments
  local numTotalSegments
  local segments
  local subSegmentData
  numPrimitives = buffer.readu32(bytes, cursor)
  cursor += 4
  _segments = buffer.readu32(bytes, cursor)
  cursor += 4
  numTotalSegments = buffer.readu32(bytes, cursor)
  cursor += 4

  do
    local count = _segments

    do
      local elements = table.create(count)

      for index = 1, count do
        elements[index], cursor = ReadStruct.BSSubIndexTriShapeSegment(stream, cursor)
      end

      segments = elements
    end

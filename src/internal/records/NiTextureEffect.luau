  local controller = record.controller

  if controller and controller >= 0 then
    linkCount += 1
    links[linkCount] = controller
  end

  local properties = record.properties

  for index = 0, properties.count - 1 do
    local value = buffer.readi32(properties.buffer, properties.offset + index * 4)

    if value >= 0 then
      linkCount += 1
      links[linkCount] = value
    end
  end

  local sourceTexture = record.sourceTexture

  if sourceTexture and sourceTexture >= 0 then
    linkCount += 1
    links[linkCount] = sourceTexture
  end

  return linkCount
end


function Scanners.NiSkinInstance(
  bytes: buffer,
  cursor: number,
  links: Links,
  linkCount: number
): (number, number)
  if buffer.readi32(bytes, cursor) >= 0 then
    linkCount += 1
    links[linkCount] = buffer.readi32(bytes, cursor)
  end

  if buffer.readi32(bytes, cursor + 4) >= 0 then
    linkCount += 1
    links[linkCount] = buffer.readi32(bytes, cursor + 4)
  end

  cursor += 8
  local bonesCount = buffer.readu32(bytes, cursor)
  cursor += 4

  for _ = 1, bonesCount do
    local link = buffer.readi32(bytes, cursor)

    if link >= 0 then
      linkCount += 1
      links[linkCount] = link
    end

    cursor += 4
  end

  return cursor, linkCount
end


  end

  cursor += 26

  if buffer.readi32(bytes, cursor + 2) >= 0 then
    linkCount += 1
    links[linkCount] = buffer.readi32(bytes, cursor + 2)
  end

  cursor += 6

  return cursor, linkCount
end


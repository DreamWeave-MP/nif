function Scanners.NiMorphData(
  bytes: buffer,
  cursor: number,
  links: Links,
  linkCount: number
): (number, number)
  local _numTargets = buffer.readu32(bytes, cursor)
  local _numVertices = buffer.readu32(bytes, cursor + 4)
  Stash.morphVertices = _numVertices
  cursor += 9

  for _ = 1, _numTargets do
    cursor, linkCount = Scanners.MorphTarget(bytes, cursor, links, linkCount)
  end

  return cursor, linkCount
end


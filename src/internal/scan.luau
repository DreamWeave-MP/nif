function Scanners.NiScreenPolygon(
  bytes: buffer,
  cursor: number,
  links: Links,
  linkCount: number
): (number, number)
  local _numVertices = buffer.readu16(bytes, cursor)
  cursor += 2
  cursor += (_numVertices) * 12
  local _hasUvCoords = buffer.readu32(bytes, cursor)
  cursor += 4
  cursor += (_hasUvCoords ~= 0 and _numVertices or 0) * 8
  local _hasVertexColors = buffer.readu32(bytes, cursor)
  cursor += 4
  cursor += (_hasVertexColors ~= 0 and _numVertices or 0) * 16
  local propertyStatesCount = buffer.readu32(bytes, cursor)
  cursor += 4
  cursor += (propertyStatesCount) * 4

  return cursor, linkCount
end


--!strict
--!native
-- What the suite's parts share: where the assets and goldens are, little-endian byte builders for
-- the files the cases make by hand, and the canonical digest the NIF port campaign's goldens
-- were recorded with (its `golden.jsl`), which is why `golden/nif.txt` still holds here.
local bytes = require '@dream/bytes'
local fs = require '@dream/fs'

--- Where this file is, from its chunk name: the folder the suite, assets, and goldens are in.
local function here(): string
  local source = debug.info(1, 's')
  local first = string.sub(source, 1, 1)
  local path = if first == '@' or first == '=' then string.sub(source, 2) else source
  return string.match(path, '^(.*)/[^/]*$') or '.'
end

local Here = here()

local function read(relative: string): string
  local path = `{Here}/{relative}`
  return fs.readFileString(path) or error(`can't read {path}`, 0)
end

--- A test asset's bytes, by file name.
local function asset(name: string): string return read(`assets/{name}`) end

--- A golden file's lines as `name<tab>value`, by name.
local function goldens(name: string): { [string]: string }
  local found = {}
  for key, value in string.gmatch(read(`golden/{name}`), '([^\t\n]+)\t([^\n]+)') do
    found[key] = value
  end

  return found
end

--- A golden text, as the file holds it.
local function goldenText(name: string): string return read(`golden/{name}`) end

local function u8(value: number): string return string.pack('<I1', value) end

local function u16(value: number): string return string.pack('<I2', value) end

local function u32(value: number): string return string.pack('<I4', value) end

local function i32(value: number): string return string.pack('<i4', value) end

local function f32(value: number): string return string.pack('<f', value) end

--- A string after its `u32` length, as every NIF version writes one inline.
local function sized(text: string): string return u32(#text) .. text end

--- A string after its `u8` length, as a Bethesda stream header writes its export strings.
local function short(text: string): string return u8(#text) .. text end

--- A canonical text fed in pieces to an xxh3 hasher.
type Sink = { hasher: any, parts: { string } }

local function put(sink: Sink, text: string)
  local parts = sink.parts
  parts[#parts + 1] = text
  if #parts < 4096 then return end

  sink.hasher:update(table.concat(parts))
  table.clear(parts)
end

local function number(value: number): string
  if value ~= value then return 'nan' end

  if value == math.floor(value) and math.abs(value) < 2 ^ 53 then
    return string.format('%d', value)
  end

  return string.format('%.17g', value)
end

local function keyText(key: unknown): string
  return if type(key) == 'number' then `#{number(key)}` else tostring(key)
end

--- Feeds `value` to `sink` canonically: tables by sorted key, sequences that build elements on
--- demand by element, array views by their bytes, functions not at all.
local function feed(sink: Sink, value: unknown)
  local kind = type(value)
  if kind == 'nil' then
    put(sink, 'n;')
    return
  end

  if kind == 'boolean' then
    put(sink, if value then 't;' else 'f;')
    return
  end

  if kind == 'number' then
    put(sink, number(value :: number) .. ';')
    return
  end

  if kind == 'string' then
    local text = value :: string
    put(sink, `s{#text}:`)
    put(sink, text)
    return
  end

  if kind == 'vector' then
    local point = value :: vector
    put(sink, `v{number(point.x)},{number(point.y)},{number(point.z)};`)
    return
  end

  if kind == 'buffer' then
    local data = value :: buffer
    put(sink, `b{buffer.len(data)}:`)
    put(sink, buffer.tostring(data))
    return
  end

  if kind ~= 'table' then return end

  local fields = value :: any
  local meta = getmetatable(fields)

  -- The package's array module is private, so an array view is told by its metatable: it has a
  -- length and, unlike the multi-version reader's lazy lists, no iterator.
  if meta and meta.__len and not meta.__iter then
    put(sink, `a{fields.count}x{fields.stride}:`)
    put(sink, buffer.readstring(fields.buffer, fields.offset, fields.count * fields.stride))
    return
  end

  if meta and meta.__len then
    local count = #fields
    put(sink, `l{count}[`)
    for index = 1, count do
      feed(sink, fields[index])
    end

    put(sink, ']')
    return
  end

  local keys = {}
  for key, entry in fields do
    if type(entry) ~= 'function' then table.insert(keys, key) end
  end

  table.sort(
    keys,
    function(left: unknown, right: unknown): boolean return keyText(left) < keyText(right) end
  )
  put(sink, '{')
  for _, key in keys do
    put(sink, keyText(key) .. '=')
    feed(sink, fields[key])
  end

  put(sink, '}')
end

--- The xxh3 digest of `value`'s canonical text.
local function digest(value: unknown): string
  local sink: Sink = { hasher = bytes.hasher 'xxh3', parts = {} }
  feed(sink, value)
  sink.hasher:update(table.concat(sink.parts))
  return sink.hasher:finish()
end

--- A call's answer, or what it threw, as a value to digest.
local function attempt(body: () -> unknown): unknown
  -- The call is one whose refusal is an answer too: the goldens hold the error's text.
  local ok, result = pcall(body)
  if ok then return result end

  local problem = result :: any
  return {
    error = if type(problem) == 'table'
      then problem.message or tostring(problem)
      else tostring(problem),
  }
end

--- What `body` threw: the message of a `{ message, record }` error, or the error as text.
local function thrown(body: () -> ()): (string?, number?)
  -- The body is expected to throw; what it throws is what's being checked.
  local ok, result = pcall(body)
  if ok then return nil, nil end

  local problem = result :: any
  if type(problem) == 'table' then return problem.message, problem.record end

  return tostring(problem), nil
end

return table.freeze {
  asset = asset,
  goldens = goldens,
  goldenText = goldenText,
  u8 = u8,
  u16 = u16,
  u32 = u32,
  i32 = i32,
  f32 = f32,
  sized = sized,
  short = short,
  digest = digest,
  attempt = attempt,
  thrown = thrown,
  xxh3 = bytes.xxh3,
}
